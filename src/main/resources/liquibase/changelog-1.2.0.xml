<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="1.2.0:CREATE_INSTITUTION" author="OpenCode">
        <createTable tableName="institution">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_institution"/>
            </column>
            <column name="code" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="specify_root_url" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="specify_asset_server_url" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="specify_username" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="institution"
                             columnNames="code"
                             constraintName="uk_institution__code"/>
        <addUniqueConstraint tableName="institution"
                             columnNames="name"
                             constraintName="uk_institution__name"/>
    </changeSet>

    <changeSet id="1.2.0:CREATE_COLLECTION" author="OpenCode">
        <createTable tableName="collection">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="pk_collection"/>
            </column>
            <column name="institution_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="name" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="specify_collection_name" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="sync_to_specify_enabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="sync_from_specify_enabled" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="collection"
                                 baseColumnNames="institution_id"
                                 constraintName="fk_collection__institution"
                                 referencedTableName="institution"
                                 referencedColumnNames="id"/>
        <addUniqueConstraint tableName="collection"
                             columnNames="institution_id,name"
                             constraintName="uk_collection__institution_id__name"/>
        <createIndex tableName="collection" indexName="idx_collection__institution_id">
            <column name="institution_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="1.2.0:ADD_COLLECTION_ID_TO_SYNC_BATCH" author="OpenCode">
        <addColumn tableName="specify_ars_sync_batch">
            <column name="collection_id" type="bigint"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="specify_ars_sync_batch"
                                 baseColumnNames="collection_id"
                                 constraintName="fk_specify_ars_sync_batch__collection"
                                 referencedTableName="collection"
                                 referencedColumnNames="id"/>
        <createIndex tableName="specify_ars_sync_batch" indexName="idx_specify_ars_sync_batch__collection_id">
            <column name="collection_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="1.2.0:ADD_COLLECTION_ID_TO_SYNC_LOG" author="OpenCode">
        <addColumn tableName="specify_sync_log">
            <column name="collection_id" type="bigint"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="specify_sync_log"
                                 baseColumnNames="collection_id"
                                 constraintName="fk_specify_sync_log__collection"
                                 referencedTableName="collection"
                                 referencedColumnNames="id"/>
        <createIndex tableName="specify_sync_log" indexName="idx_specify_sync_log__collection_id">
            <column name="collection_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
